<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.billion.supabase-trial-app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file=__TRIAL_ROOT__/app-runtime.env</string>
    <string>__TRIAL_ROOT__/app/apps/nextjs/node_modules/next/dist/bin/next</string>
    <string>start</string>
    <string>--hostname</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>3006</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TRIAL_ROOT__/app/apps/nextjs</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__TRIAL_ROOT__/app.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__TRIAL_ROOT__/app.stderr.log</string>
</dict>
</plist>
