# `pnpm run prod` loads production credentials from `.env`, then this file.
# Keep Expo pointed at the local Next.js server so local code remains testable.
POSTGRES_URL=postgresql://PRODUCTION_CONNECTION_STRING
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
